{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Postgres": {
      "DB_HOST": "localhost",
      "DB_PORT": "5432",
      "DB_NAME": "eduflowhub",
      "DB_USER": "postgres",
      "DB_PASSWORD": ""
    }
  },

  "Authentication": {
    "Jwt": {
      "Issuer": "EduFlowHub",
      "Audience": "EduFlowHub.Client",
      "SecretKey": "",
      "ExpirationMinutes": 15
    }
  },
  "FileStorage": {
    "Local": {
      "RootPath": "",
      "MaxFileSize": 524288000,
      "SupportedFileFormats": {
        "Extensions": [".pdf", ".jpg", ".webp", ".png"]
      }
    }
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  }
}
