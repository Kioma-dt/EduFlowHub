{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "Authentication": {
    "Jwt": {
      "Issuer": "EduFlowHub",
      "Audience": "EduFlowHub.Client",
      "SecretKey": "",
      "ExpirationMinutes": 15
    }
  },
  "FileStorage": {
    "Local": {
      "RootPath": "",
      "MaxFileSize": 524288000,
      "SupportedFileFormats": {
        "Extensions": [".pdf", ".jpg", ".webp", ".png"]
      }
    }
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  }
}
